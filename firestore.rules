rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Visit log: any public visitor may create their own entry and update it
    // with a close time/duration, but only the admin can read or delete it
    // (IPs and timing stay private).
    match /visits/{id} {
      allow create, update: if true;
      allow read, delete: if request.auth != null;
    }

    // Everything else: anyone can read (public site); only the admin can write.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
